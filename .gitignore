# =========================
# Data / generated files
# =========================

# User inputs and pipeline artifacts (only .gitkeep is versioned)
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# CSV/ODS files
*.csv
*.csv#
*.ods
*.ods#
*.xlsx
*.xlsx#
*.xls
*.xls#

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.token

# =========================
# IDE / Editor
# =========================

.vscode/
.idea/

# =========================
# OS
# =========================

.DS_Store
Thumbs.db

# =========================
# Build / distribution
# =========================

build/
dist/
*.egg-info/

